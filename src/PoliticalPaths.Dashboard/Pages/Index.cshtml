@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="page-heading"><div><div class="page-kicker">Centrum analityczne</div><h1>Witaj w Political Paths</h1><p class="page-intro">Przegląd danych wyborczych, polityków i mandatów.</p></div><span class="badge-soft">● Dane aktualne</span></div>
<div class="row g-3"><div class="col-sm-6 col-xl-3"><div class="card kpi-card"><span class="kpi-label">Zaimportowane pliki</span><strong class="kpi-value">@Model.Summary.Files</strong><span class="kpi-icon">↥</span></div></div><div class="col-sm-6 col-xl-3"><div class="card kpi-card"><span class="kpi-label">Przeprowadzone wybory</span><strong class="kpi-value">@Model.Summary.Elections</strong><span class="kpi-icon">▣</span></div></div><div class="col-sm-6 col-xl-3"><div class="card kpi-card"><span class="kpi-label">Zarejestrowani politycy</span><strong class="kpi-value">@Model.Summary.Politicians</strong><span class="kpi-icon">◎</span></div></div><div class="col-sm-6 col-xl-3"><div class="card kpi-card"><span class="kpi-label">Utworzone mandaty</span><strong class="kpi-value">@Model.Summary.Mandates</strong><span class="kpi-icon">★</span></div></div></div>
<div class="row g-3 mt-3"><div class="col-lg-8"><div class="card p-4"><div class="section-title mt-0">Panel danych</div><p class="page-intro mb-0">Skorzystaj z nawigacji, aby przeglądać zaimportowane pliki, analizować wyniki wyborów lub wyszukać historię konkretnego polityka.</p><div class="mt-4 d-flex gap-2 flex-wrap"><a class="btn btn-primary" asp-page="/Politicians/Index">Przeglądaj polityków</a><a class="btn btn-light border" asp-page="/Elections/Index">Zobacz wybory</a></div></div></div><div class="col-lg-4"><div class="card p-4 h-100"><div class="page-kicker">O systemie</div><h2 class="section-title mt-1">Political Paths</h2><p class="page-intro">Jedno miejsce do eksploracji historii polskich wyborów i mandatów.</p></div></div></div>
