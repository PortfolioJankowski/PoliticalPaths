@page "{id:guid}"
@model PoliticalPaths.Dashboard.Pages.Politicians.DetailsModel
@{
    ViewData["Title"] = Model.Politician!.Name;
}
<div class="page-heading">
    <div>
        <div class="page-kicker">Profil polityka</div>
        <h1>@Model.Politician.Name</h1>
        <p class="page-intro">Data urodzenia: @(Model.Politician.BirthDate?.ToString("dd.MM.yyyy") ?? "brak danych")</p>
    </div>
</div>

<section>
    <h2 class="section-title">Starty wyborcze</h2>
    @if (Model.Politician.Participations.Count == 0) {
        <div class="card p-4"><p class="page-intro m-0">Brak zarejestrowanych startów wyborczych.</p></div>
    }
    @foreach (var participation in Model.Politician.Participations) {
        <partial name="_ParticipationDetails" model="participation" />
    }
</section>

<section>
    <h2 class="section-title">Zdarzenia mandatowe</h2>
    @if (Model.Politician.Events.Count == 0) {
        <div class="card p-4"><p class="page-intro m-0">Brak zarejestrowanych zdarzeń mandatowych.</p></div>
    } else {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Data</th><th>Typ</th><th>Opis</th><th>Dokument</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Politician.Events) {
                    <tr><td>@item.Date.ToString("dd.MM.yyyy")</td><td>@item.Type</td><td>@(item.Description ?? "—")</td><td>@(item.Reference ?? "—")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
