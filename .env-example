# MariaDB Credentials
MARIADB_ROOT_PASSWORD=SuperSecretRootPassword123!
MARIADB_DATABASE=politicalpaths
MARIADB_USER=politicalpaths_user
MARIADB_PASSWORD=StrongUserPassword456!

# Redis Configuration
REDIS_PASSWORD=SecureRedisPassword789!

# First administrator (required by sync/full-sync)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# RabbitMQ credentials
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=politicalpaths
RABBITMQ_PASSWORD=replace-with-a-strong-password
RABBITMQ_USE_TLS=false

# Discord webhook (secret; never commit the real value)
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Political Paths

# SendGrid (API key and verified sender)
SENDGRID_ENABLED=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@example.com
SENDGRID_FROM_NAME=Political Paths
